# ---- NarrativeForge environment ----
# Leave the Azure values blank to run fully offline on the deterministic mock
# LLM and bundled Foundry IQ knowledge base. Fill them in to go live.

ENVIRONMENT=local

# Azure OpenAI (chat completions)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Foundry (Foundry IQ knowledge base grounding)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_KB_ID=

# Infra (optional). Empty REDIS_URL -> in-memory store.
REDIS_URL=
CORS_ORIGINS=*
